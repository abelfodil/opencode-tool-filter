{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@abelfodil/opencode-tool-filter",
  "version": "0.2.3",
  "description": "OpenCode plugin that semantically filters MCP tools before sending them to the LLM",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abelfodil/opencode-tool-filter.git"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@huggingface/transformers": "latest",
    "zod": "latest"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@opencode-ai/sdk": "latest",
    "@types/bun": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "keywords": [
    "opencode",
    "plugin",
    "mcp",
    "tools",
    "semantic-search",
    "embeddings"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
